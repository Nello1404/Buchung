# Lokale Postgres-Datenbank (siehe README "Lokales Setup")
DATABASE_URL="postgresql://flyspot:flyspot_dev@localhost:5432/flyspot_valet?schema=public"

# Stripe Testmodus-Keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Webhook-Signing-Secret: https://dashboard.stripe.com/test/webhooks (oder `stripe listen`)
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (Transaktions-E-Mails): https://resend.com/api-keys
# Ohne Key werden E-Mails nur in die Konsole geloggt (praktisch für die lokale Entwicklung).
RESEND_API_KEY=""
EMAIL_FROM="FlySpot Valet <buchung@flyspot-valet.de>"
# Empfaenger des woechentlichen Cockpit-Reports (Geschaeftsfuehrung).
REPORT_EMAIL="management@flyspot-valet.de"
# Empfaenger der Uebergabeprotokoll-PDFs (Betrieb). Fallback: REPORT_EMAIL.
PROTOKOLL_EMAIL="service@flyspot-valet.de"
# Geheimnis fuer den Vercel-Cron-Aufruf des Wochenreports (beliebige Zufallszeichen).
CRON_SECRET=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Logo: standardmäßig wird public/logo.png verwendet (Fallback: public/logo.svg).
# Optional anderen Dateinamen erzwingen, z. B. "/logo-weiss.png".
NEXT_PUBLIC_LOGO_FILE=""

# Admin-Login (Phase 2) – in Vercel setzen, niemals committen
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Zufälliger Schlüssel (mind. 32 Zeichen) zum Signieren der Admin-Session
AUTH_SECRET=""

# Cockpit TV-Modus – Passwort fuer den Anzeige-Bildschirm im Container
COCKPIT_TV_PASSWORD=""

# Vercel Blob (Bilder-Verwaltung im Admin): in Vercel einen Blob-Store anlegen,
# der Token wird dort automatisch als BLOB_READ_WRITE_TOKEN gesetzt.
BLOB_READ_WRITE_TOKEN=""
