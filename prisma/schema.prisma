// Prisma-Schema FlySpot Valet – Phase 1 (Buchungsstrecke)
// Alle Geldbeträge werden als ganze Cent-Beträge (Int) gespeichert, um Rundungsfehler
// bei der Preisberechnung zu vermeiden (z. B. 3900 = 39,00 EUR).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCode {
  VALET
  SHUTTLE
}

/// Kategorien für die Bildergalerie auf der Webseite.
enum ImageCategory {
  STELLPLATZ
  TEAM
  FLOTTE
  AUFBEREITUNG
}

/// Zeitpunkt eines Übergabeprotokolls: Fahrzeug-Übernahme (Einfahrt) oder
/// Rückgabe an den Kunden (Ausfahrt).
enum HandoverPhase {
  EINFAHRT
  AUSFAHRT
}

enum BookingStatus {
  ANGEFRAGT
  BEZAHLT
  UEBERGEBEN
  GEPARKT
  BEREITGESTELLT
  ABGESCHLOSSEN
  STORNIERT
}

enum PaymentStatus {
  OFFEN
  BEZAHLT
  TEILERSTATTET
  ERSTATTET
  FEHLGESCHLAGEN
}

model Customer {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  vouchers  Voucher[]
}

model Product {
  id           String        @id @default(cuid())
  code         ProductCode   @unique
  name         String
  active       Boolean       @default(true)
  tariffRules  TariffRule[]
  seasonRates  SeasonRate[]
  blockedDays  BlockedDay[]
  capacityDays CapacityDay[]
  bookings     Booking[]
}

/// Fahrzeugklasse (z. B. Kleinwagen/Mittelklasse/SUV & Van) – frei im Admin
/// erweiterbar. Bestimmt eigene Preistabellen für Parkgebühr (TariffRule/
/// SeasonRate) und Zusatzservices (ServiceAddonPrice). Beeinflusst NICHT das
/// Tages-Kontingent (jede Buchung belegt weiterhin genau 1 Slot/Tag).
model VehicleClass {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  sortOrder         Int                @default(0)
  active            Boolean            @default(true)
  tariffRules       TariffRule[]
  seasonRates       SeasonRate[]
  addonPrices       ServiceAddonPrice[]
  vehicles          Vehicle[]
}

/// Preis pro Tag, gestaffelt nach Parkdauer (volle Kalendertage), je Produkt UND
/// Fahrzeugklasse (komplett eigene Preistabelle je Klasse).
model TariffRule {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleClassId String
  vehicleClass   VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Cascade)
  minTage        Int
  /// null = unbegrenzt (letzte, offene Staffel, z. B. "ab 15 Tagen")
  maxTage        Int?
  preisProTagCent Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId, vehicleClassId])
}

/// Saison-Zeitraum mit eigenem (festen) Tagespreis je Produkt UND Fahrzeugklasse –
/// ersetzt für Tage innerhalb des Zeitraums den regulären Staffelpreis aus TariffRule.
/// Saison-Zeitraum je Produkt. Entweder prozentualer Zuschlag auf den Basis-
/// Staffelpreis (zuschlagProzent, gilt für alle Fahrzeugklassen des Produkts, wenn
/// vehicleClassId = null) ODER ein fester Tagespreis (preisProTagCent, je Klasse).
model SeasonRate {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleClassId String?
  vehicleClass   VehicleClass? @relation(fields: [vehicleClassId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  /// Fester Tagespreis (optional; wenn gesetzt, ersetzt er den Staffelpreis).
  preisProTagCent Int?
  /// Prozentualer Zuschlag auf den Staffelpreis (optional; z. B. 20 = +20 %).
  zuschlagProzent Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId, vehicleClassId, startDate, endDate])
}

/// Sperrtage: an diesen Tagen ist das Produkt (oder bei productId=null: global) nicht buchbar.
model BlockedDay {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([productId, date])
}

/// Kontingent & Belegung je Produkt und Kalendertag. `belegt` wird atomar innerhalb
/// der Buchungs-Transaktion hoch-/heruntergezählt (siehe lib/capacity.ts).
model CapacityDay {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kontingent Int
  belegt    Int      @default(0)

  @@unique([productId, date])
  @@index([date])
}

model ServiceAddon {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingAddons BookingAddon[]
  preise        ServiceAddonPrice[]
}

/// Preis eines Zusatzservices – eigene Preistabelle je Fahrzeugklasse
/// (z. B. Aufbereitung SUV teurer als Kleinwagen).
model ServiceAddonPrice {
  id             String       @id @default(cuid())
  serviceAddonId String
  serviceAddon   ServiceAddon @relation(fields: [serviceAddonId], references: [id], onDelete: Cascade)
  vehicleClassId String
  vehicleClass   VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Cascade)
  preisCent      Int

  @@unique([serviceAddonId, vehicleClassId])
}

model BookingAddon {
  id             String       @id @default(cuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceAddonId String
  serviceAddon   ServiceAddon @relation(fields: [serviceAddonId], references: [id])
  /// Preis zum Buchungszeitpunkt (Snapshot) – spätere Preisänderungen im Admin
  /// wirken sich nicht rückwirkend auf bestehende Buchungen aus.
  preisCentSnapshot Int
  nameSnapshot      String

  @@index([bookingId])
}

enum VoucherTyp {
  TAG_GRATIS // 1 Tag gratis (Langzeit-Tagespreis des Produkts)
  PROZENT    // prozentualer Rabatt auf Parken + Zusatzservices
  BETRAG     // fester Euro-Rabatt (in Cent)
}

/// Gutschein/Rabattcode – einmalig einlösbar. Kann an einen Kunden gebunden sein
/// (Treueaktion) oder generisch für eine Rabattaktion (customerId = null).
model Voucher {
  id               String    @id @default(cuid())
  code             String    @unique
  typ              VoucherTyp @default(TAG_GRATIS)
  /// Wert je nach Typ: PROZENT = Prozentsatz, BETRAG = Cent, TAG_GRATIS = ungenutzt.
  wert             Int       @default(0)
  bezeichnung      String?
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issuedAt         DateTime  @default(now())
  redeemedAt       DateTime?
  redeemedBookingId String?  @unique
  redeemedBooking  Booking?  @relation("VoucherRedemption", fields: [redeemedBookingId], references: [id])

  @@index([customerId])
}

model Vehicle {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kennzeichen    String
  marke          String?
  farbe          String?
  auffaelligkeiten String?

  /// Vom Kunden bei Buchung gewählte Fahrzeugklasse (bestimmt den Preis).
  /// Eine Korrektur durch das Personal bei Übergabe inkl. Nachberechnung folgt
  /// in Phase 3 zusammen mit dem Übergabeprotokoll.
  vehicleClassId       String
  vehicleClass         VehicleClass @relation(fields: [vehicleClassId], references: [id])
  vehicleClassNameSnapshot String
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId String?       @unique
  betragCent            Int
  erstattetCent         Int           @default(0)
  status                PaymentStatus @default(OFFEN)
  /// Zahlungsart: null = Online/Stripe. Bei manuellen Buchungen (Telefonkunden)
  /// z. B. "BAR", "EC", "UEBERWEISUNG" oder "RECHNUNG".
  zahlungsart           String?
  /// Zeitpunkt des Zahlungseingangs (gesetzt vom Stripe-Webhook oder manuell).
  /// Stichtag für die Umsatzauswertung im Cockpit.
  bezahltAm             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([bezahltAm])
}

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  status          BookingStatus @default(ANGEFRAGT)

  anreise         DateTime
  abreise         DateTime
  flugnummer      String?

  preisTageCent      Int
  preisAddonsCent    Int         @default(0)
  gutscheinRabattCent Int        @default(0)
  preisGesamtCent    Int
  preisBreakdown     Json

  /// Zum Buchungszeitpunkt gültige Storno-Konditionen (Snapshot aus Settings) –
  /// spätere Admin-Änderungen wirken sich nicht rückwirkend auf diese Buchung aus.
  stornoFristStunden         Int @default(48)
  stornoErstattungFruehProzent Int @default(100)
  stornoErstattungSpaetProzent Int @default(50)

  storniertAm     DateTime?
  erstattungProzent Int?

  /// Interne Notiz (z. B. bei manuellen Telefonbuchungen). Nicht kundensichtbar.
  notiz           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vehicle         Vehicle?
  payment         Payment?
  addons          BookingAddon[]
  voucherRedemption Voucher?    @relation("VoucherRedemption")
  protokolle      HandoverProtocol[]

  @@index([customerId])
  @@index([productId, anreise, abreise])
}

/// Globale, im Admin änderbare Einstellungen (Singleton-Row, id = "default").
model Settings {
  id                     String @id @default("default")
  stornoFristStunden     Int    @default(48)
  stornoErstattungFrueh  Int    @default(100)
  stornoErstattungSpaet  Int    @default(50)
  /// Empfohlener Steuer-Rücklagensatz in % vom Monatsergebnis (Gewinn).
  steuerRuecklageProzent Int    @default(25)
  /// Frühwarn-Schwellen (im Cockpit änderbar).
  warnAuslastungProzent  Int    @default(40)
  warnTagVollProzent     Int    @default(90)
  warnStornoquoteProzent Int    @default(20)
  updatedAt              DateTime @updatedAt
}

/// Planwerte je Monat (aus der Kalkulations-Excel eingetragen) für die Plan-Ist-Ampel.
model PlanMonth {
  id                       String   @id @default(cuid())
  jahr                     Int
  monat                    Int
  auslastungValetProzent   Int      @default(0)
  auslastungShuttleProzent Int      @default(0)
  umsatzCent               Int      @default(0)
  kostenCent               Int      @default(0)
  updatedAt                DateTime @updatedAt

  @@unique([jahr, monat])
}

// ---- Betriebszentrale Phase 3: Einnahmen/Ausgaben (leichtgewichtig) ----

/// Ausgaben-Kategorie, im Admin pflegbar (umbenennen/ergänzen/deaktivieren).
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  /// Optionales Monatsbudget (Brutto, Cent). Überschreitung löst Frühwarnung aus.
  monatsBudgetCent Int?
  createdAt DateTime @default(now())

  expenses  Expense[]
  recurring RecurringExpense[]
}

/// Einzelne Ausgabe (Brutto inkl. USt). Von der Geschäftsführung erfasst.
model Expense {
  id          String          @id @default(cuid())
  datum       DateTime        @db.Date
  betragCent  Int
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  notiz       String?
  erfasstVon  String
  /// Verknüpfung, falls automatisch aus einer wiederkehrenden Ausgabe erzeugt.
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  /// Monat (YYYY-MM) bei wiederkehrenden Ausgaben – verhindert Duplikate.
  periodeKey  String?
  createdAt   DateTime        @default(now())

  @@unique([recurringId, periodeKey])
  @@index([datum])
  @@index([categoryId])
}

/// Wiederkehrende Ausgabe (z. B. Miete monatlich). Wird automatisch materialisiert.
model RecurringExpense {
  id         String          @id @default(cuid())
  name       String
  betragCent Int
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  startDatum DateTime        @db.Date
  aktiv      Boolean         @default(true)
  createdAt  DateTime        @default(now())

  expenses   Expense[]
}

/// Pflegbare Inhaltsseiten (Impressum, Datenschutz, AGB). Inhalt vom Anwalt.
model ContentPage {
  slug      String   @id
  titel     String
  inhalt    String   @default("")
  updatedAt DateTime @updatedAt
}

/// Über den Admin gepflegte Bilder (Stellplatz/Team/Flotte/Aufbereitung),
/// gespeichert in Vercel Blob. `url` = öffentliche Blob-URL, `pathname` wird
/// zum Löschen aus dem Blob-Store benötigt.
model SiteImage {
  id        String        @id @default(cuid())
  kategorie ImageCategory
  url       String
  pathname  String
  alt       String        @default("")
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@index([kategorie, active, sortOrder])
}

/// Übergabeprotokoll: dokumentiert Fahrzeug-Übernahme/-Rückgabe durch den Fahrer
/// (Kilometer-/Tankstand, Bemerkungen, Fotos, Kundenunterschrift).
model HandoverProtocol {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  phase            HandoverPhase
  fahrer           String
  kmStand          Int?
  tankstand        String?
  bemerkung        String?
  /// Kundenunterschrift als Bild (Vercel Blob). Optional, falls kein Blob-Store.
  unterschriftUrl  String?
  unterschriftPfad String?
  erstelltVon      String
  createdAt        DateTime      @default(now())

  fotos            HandoverPhoto[]

  @@index([bookingId])
}

/// Einzelnes Foto zu einem Übergabeprotokoll (in Vercel Blob gespeichert).
model HandoverPhoto {
  id         String           @id @default(cuid())
  protocolId String
  protocol   HandoverProtocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  url        String
  pathname   String
  createdAt  DateTime         @default(now())

  @@index([protocolId])
}

/// Audit-Log für Änderungen an Finanzdaten (wer, wann, was).
model AuditLog {
  id        String   @id @default(cuid())
  email     String
  aktion    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
